# Copy to .env.support.local (ignored). Loaded ONLY by scripts/demo-server.ts.
# Default is free, deterministic demo mode. No external requests are made.
SUPPORT_ENABLED=true
SUPPORT_PROVIDER=mock
# To deliberately enable paid requests later, set provider=openai and configure:
SUPPORT_MODEL=
SUPPORT_API_KEY=
# Never use NEXT_PUBLIC_ or VITE_ for credentials. Do not commit the local file.
